<%- include('../partials/head', { title: 'Reminders' }) %>
<%- include('../partials/nav', { userEmail: userEmail, currentPage: 'reminders' }) %>
<main class="container">
  <div class="page-header">
    <h1>Reminders</h1>
    <a class="button" href="/reminders/new">+ New reminder</a>
  </div>
  <p class="hint">Reminders combine standalone reminders and tasks with a due date, soonest first.</p>

  <% if (items.length === 0) { %>
    <p class="empty-state">No upcoming reminders.</p>
  <% } else { %>
  <ul class="item-list">
    <% items.forEach(function(item) {
         var isOverdue = item.due_at < now;
         var isDueToday = !isOverdue && item.due_at.slice(0, 10) === now.slice(0, 10);
         var editHref = item.kind === 'task' ? '/tasks/' + item.id + '/edit' : '/reminders/' + item.id + '/edit';
    %>
    <li class="item-card">
      <div class="item-body">
        <a href="<%= editHref %>" class="item-title"><%= item.title %></a>
        <span class="badge <%= isOverdue ? 'badge-overdue' : (isDueToday ? 'badge-due-today' : '') %>">
          <%= isOverdue ? 'Overdue' : (isDueToday ? 'Due today' : 'Upcoming') %>:
          <%= new Date(item.due_at).toLocaleString() %>
        </span>
        <span class="tag"><%= item.kind === 'task' ? 'Task' : 'Reminder' %></span>
      </div>
      <div class="item-actions">
        <a href="<%= editHref %>">Edit</a>
        <% if (item.kind === 'reminder') { %>
        <form method="POST" action="/reminders/<%= item.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this reminder?');">
          <button type="submit" class="link-button">Delete</button>
        </form>
        <% } %>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>
<%- include('../partials/foot') %>
