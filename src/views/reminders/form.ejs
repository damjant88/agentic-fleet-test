<%- include('../partials/head', { title: reminder && reminder.id ? 'Edit reminder' : 'New reminder' }) %>
<%- include('../partials/nav', { userEmail: userEmail, currentPage: 'reminders' }) %>
<main class="container narrow">
  <h1><%= reminder && reminder.id ? 'Edit reminder' : 'New reminder' %></h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="POST" action="<%= reminder && reminder.id ? '/reminders/' + reminder.id : '/reminders' %>" class="stack-form">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= reminder ? reminder.title : '' %>" required maxlength="200">

    <label for="due_at">Due date/time</label>
    <%
      var dueAtValue = '';
      if (reminder && reminder.due_at) {
        var d = new Date(reminder.due_at);
        dueAtValue = isNaN(d.getTime()) ? reminder.due_at : d.toISOString().slice(0, 16);
      }
    %>
    <input type="datetime-local" id="due_at" name="due_at" value="<%= dueAtValue %>" required>

    <button type="submit"><%= reminder && reminder.id ? 'Save changes' : 'Create reminder' %></button>
  </form>
  <p><a href="/reminders">Back to reminders</a></p>
</main>
<%- include('../partials/foot') %>
