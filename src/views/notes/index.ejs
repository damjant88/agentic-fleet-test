<%- include('../partials/head', { title: 'Notes' }) %>
<%- include('../partials/nav', { userEmail: userEmail, currentPage: 'notes' }) %>
<main class="container">
  <div class="page-header">
    <h1>Notes</h1>
    <a class="button" href="/notes/new">+ New note</a>
  </div>

  <% if (notes.length === 0) { %>
    <p class="empty-state">No notes yet.</p>
  <% } else { %>
  <ul class="item-list">
    <% notes.forEach(function(note) { %>
    <li class="item-card">
      <div class="item-body">
        <a href="/notes/<%= note.id %>/edit" class="item-title"><%= note.title %></a>
        <p class="item-preview"><%= note.body.slice(0, 140) %><%= note.body.length > 140 ? '…' : '' %></p>
      </div>
      <div class="item-actions">
        <a href="/notes/<%= note.id %>/edit">Edit</a>
        <form method="POST" action="/notes/<%= note.id %>/delete" class="inline-form" onsubmit="return confirm('Delete this note?');">
          <button type="submit" class="link-button">Delete</button>
        </form>
      </div>
    </li>
    <% }); %>
  </ul>
  <% } %>
</main>
<%- include('../partials/foot') %>
